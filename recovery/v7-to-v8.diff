+    function sortFramesByName(direction) {
+      if (!direction || direction === 'none') return;
+
+      const byId = new Map(allFrames.map(frame => [frame.id, frame]));
+      const orderIndex = new Map(frameOrder.map((id, index) => [id, index]));
+
+      frameOrder.sort((a, b) => {
+        const frameA = byId.get(a);
+        const frameB = byId.get(b);
+
+        const nameA = frameA ? frameA.name : '';
+        const nameB = frameB ? frameB.name : '';
+
+        const comparison = nameA.localeCompare(nameB, undefined, { numeric: true, sensitivity: 'base' });
+        if (comparison !== 0) {
+          return direction === 'az' ? comparison : -comparison;
+        }
+
+        return (orderIndex.get(a) || 0) - (orderIndex.get(b) || 0);
+      });
+
+      renderFrameList();
+      showStatus(`Sorted ${frameOrder.length} frame${frameOrder.length !== 1 ? 's' : ''} (${direction === 'az' ? 'A–Z' : 'Z–A'})`, 'info');
     }
 
